# ── 필수 ──────────────────────────────────────────────
# Slack Incoming Webhook URL (README 참고)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ── 타깃 대회 ─────────────────────────────────────────
PRODUCT_ID=19627
COMP_ID=18962
# 관심 종목만 감시하려면 쉼표로 나열 (비우면 판매중(isUse) 종목 전체). 예: HALF,10K
WATCH_EVENTS=HALF,10K

# ── 폴링/알림 제어 ────────────────────────────────────
# 기본 체크 간격(초). 여기에 0~POLL_JITTER 초의 랜덤 지연이 더해짐
POLL_INTERVAL=4
POLL_JITTER=2
# 같은 종목에 대해 재알림하지 않는 시간(초)
ALERT_COOLDOWN=300
# 재고가 다시 0이 되었을 때도 알림 보낼지
NOTIFY_SOLD_OUT=true
# 이상 없어도 "정상 감시 중" 알림을 보내는 간격(초). 3600=1시간, 0=끔
HEARTBEAT_INTERVAL=3600

# ── 2단계 자동 신청(auto_apply.py) ────────────────────
# 브라우저 프로필 저장 경로 (로그인 상태 유지)
BROWSER_PROFILE_DIR=./browser-profile
HEADLESS=false
# 신청 옵션 (실제 드롭다운 문구와 일치해야 함)
APPLY_EVENT=HALF
APPLY_PARTICIPANT_NAME=홍길동
# 목표기록: 예) "하프 1:50:00 이내" / "10K 55:00 이내"
APPLY_TARGET_TIME=하프 1:50:00 이내
# 티셔츠/싱글렛 사이즈: 예) "남성 L" (HALF 싱글렛) / "L" (10K 티셔츠)
APPLY_SHIRT_SIZE=남성 XL
# 이전 신청 진행 정보가 있을 때 "이어하기" 대신 "아니오"(초기화)를 선택하려면 false
APPLY_RESUME_PREVIOUS=true
